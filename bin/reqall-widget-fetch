#!/bin/bash

# Collects everything the Reqall bar widget shows and prints it as one JSON
# document on stdout. The QML side never talks to the network itself; it runs
# this script and reads the result, the same split omarchy.agents uses.
#
# Credentials are resolved by reqall-widget-lib.sh (see there for the order).
#
# Output shape:
#   { "auth": "ok"|"none"|"invalid"|"paused"|"error", "url": "...", "cli": bool,
#     "source": "...", "message": "...", "fetchedAt": "...",
#     "counts": { "records": n, "openTodos": n, "openIssues": n, "projects": n },
#     "recent": [ { id, kind, title, status, project_name, updated_at }, ... ] }
#
# Exit status is always 0 so the caller can rely on stdout; failures are in the
# document's "auth" and "message" fields.

set -o pipefail

recent="${REQALL_WIDGET_RECENT:-6}"
project="${REQALL_WIDGET_PROJECT:-}"

# shellcheck source=reqall-widget-lib.sh
source "$(dirname "${BASH_SOURCE[0]}")/reqall-widget-lib.sh"

emit() {
  # emit <auth> <message>
  jq -nc --arg auth "$1" --arg message "$2" --arg url "$url" --arg source "$source_name" \
    --argjson cli "$has_cli" \
    '{auth: $auth, message: $message, url: $url, source: $source, cli: $cli,
      fetchedAt: (now | todate), counts: null, recent: []}'
}

missing=$(require_tools) || { emit error "$missing is not installed"; exit 0; }

if [[ -z $key ]]; then
  emit none "No Reqall credentials found"
  exit 0
fi

fail_from_status() {
  local last_error
  last_error=$(mcp_error)
  case $1 in
    3) emit invalid "${last_error:-Invalid credentials}" ;;
    4) emit paused "${last_error:-Access denied}" ;;
    *) emit error "${last_error:-Request failed}" ;;
  esac
  exit 0
}

filter='{}'
[[ -n $project ]] && filter=$(jq -nc --arg p "$project" '{project_name: $p}')

recent_json=$(mcp list_records "$(jq -c --argjson n "$recent" '. + {limit: $n}' <<<"$filter")") || fail_from_status $?
todos_json=$(mcp list_records "$(jq -c '. + {limit: 1, status: "open", kind: "todo"}' <<<"$filter")") || fail_from_status $?
issues_json=$(mcp list_records "$(jq -c '. + {limit: 1, status: "open", kind: "issue"}' <<<"$filter")") || fail_from_status $?
if [[ -n $project ]]; then
  projects_json='{"data":{"total":1}}'
else
  projects_json=$(mcp list_projects '{"limit": 1}') || fail_from_status $?
fi

jq -nc \
  --arg url "$url" --arg source "$source_name" --argjson cli "$has_cli" \
  --argjson recent "$recent_json" --argjson todos "$todos_json" \
  --argjson issues "$issues_json" --argjson projects "$projects_json" \
  '{auth: "ok", message: "", url: $url, source: $source, cli: $cli,
    fetchedAt: (now | todate),
    counts: {
      records: ($recent.data.total // 0),
      openTodos: ($todos.data.total // 0),
      openIssues: ($issues.data.total // 0),
      projects: ($projects.data.total // 0)
    },
    recent: ($recent.data.records // [])}'
